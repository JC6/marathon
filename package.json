    "test:e2e": "playwright test",
    "validate": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": { "phaser": "4.2.1" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
